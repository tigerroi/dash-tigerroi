# === TigerROI Sync Jobs (Skrip Sinkronisasi Terjadwal / Cron VPS) ===============
# File konfigurasi untuk worker/skrip cron mandiri di VPS Hetzner (pengganti Cloud Functions).
# Salin ke `jobs/.env` pada mesin VPS tempat cron job berjalan.

# --- Supabase (Postgres Database) -------------------------------------------------
# Kunci service_role HANYA boleh di backend jobs/server untuk akses database penuh (melewati RLS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Connection String PostgreSQL Supabase
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# --- Meta Marketing API (Facebook / Instagram Ads) --------------------------------
# System User Long-Lived Token dari Meta Business Manager
META_ACCESS_TOKEN=

# Pajak iklan yang ditambahkan ke belanja Meta sebelum ROI dihitung (contoh: 0.05 = 5%)
AD_TAX_RATE=0.05

# Riwayat snapshot saldo akun iklan Meta yang disimpan (720 snapshot ~ 30 hari jika sync tiap jam)
BALANCE_SNAPSHOT_KEEP=720
BALANCE_HISTORY_DAYS=30

# --- Google Ad Manager (GAM) & AdSense -------------------------------------------
# Berapa hari ke belakang yang ditarik ulang dari API laporan GAM tiap siklus sync
GAM_RANGE_DAYS=3
# Dimensi negara pada penarikan laporan GAM
GAM_COUNTRY_DIMENSIONS=COUNTRY_CODE,COUNTRY_NAME

# --- Pengaturan Konversi Mata Uang & Finansial ------------------------------------
# Endpoint penarikan kurs valas harian
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# Masa simpan baris ROI harian dalam hari (0 = disimpan selamanya / disarankan)
ROI_HISTORY_DAYS=0

# --- Notifikasi Telegram Bot ------------------------------------------------------
# Token bot Telegram dan ID grup/chat tujuan pengiriman alert anomali, saldo, & reminder
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- Zona Waktu Eksekusi Cron -----------------------------------------------------
SYNC_TIMEZONE=Asia/Jakarta
