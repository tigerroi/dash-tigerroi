# === functions/.env.sync — Konfigurasi sync lokal (CLI tools) ===================================
# Dipakai oleh script `npm run sync:*`, `npm run authorize`, dll. di folder functions/.
# TIDAK dipakai Cloud Function terjadwal (yang memakai Firebase Secrets, bukan file ini).
# Salin ke functions/.env.sync dan isi nilainya. File ini diabaikan git (.env.*).

# --- Firebase (client SDK, bukan service account) -----------------------------------------------
# Dipakai functions/db.mjs untuk login ke RTDB sebagai user yang sudah terdaftar.
# Nilai FIREBASE_API_KEY, FIREBASE_APP_ID, dll. sama dengan yang ada di root/.env (VITE_FIREBASE_*),
# hanya tanpa prefix VITE_.
FIREBASE_API_KEY=AIzaSyDArkLR7AEUSKc6OhqfjnpMifG_AvSx4gM
FIREBASE_AUTH_DOMAIN=dashboard-tigerroi.firebaseapp.com
FIREBASE_PROJECT_ID=dashboard-tigerroi
FIREBASE_APP_ID=1:19435001836:web:f98b3cfb5f6d5a42cc52c9
FIREBASE_DATABASE_URL=https://dashboard-tigerroi-default-rtdb.asia-southeast1.firebasedatabase.app

# Akun Firebase yang dipakai untuk membaca/menulis RTDB dari CLI.
# Harus punya role admin di /roles/{uid}.
SYNC_USER_EMAIL=
SYNC_USER_PASSWORD=

# --- Meta Ads API -------------------------------------------------------------------------------
# System User token Business Manager. Dibutuhkan oleh sync:meta, meta:check, dll.
META_ACCESS_TOKEN=

# --- Google Ads Manager (GAM) -------------------------------------------------------------------
# Diisi oleh `npm run authorize` (OAuth flow). Jangan isi manual.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Network code GAM Anda (GAM Console → Admin → Network settings → Network code).
GAM_NETWORK_CODE=

# --- Google AdSense -----------------------------------------------------------------------------
# Publisher ID AdSense (format: pub-XXXXXXXXXXXXXXXX).
ADSENSE_PUBLISHER_ID=

# --- Telegram ------------------------------------------------------------------------------------
# Token bot Telegram dari @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Keitaro / vi-control (gating) --------------------------------------------------------------
# Dipakai oleh sync:gating.
VI_CONTROL_API_KEY=
VI_CONTROL_BASE_URL=https://your-vicontrol-domain.example.com:8443
KEITARO_BASE_URL=https://your-keitaro-domain.example.com
KEITARO_API_KEY=

# --- Dashboard URL (untuk tautan Telegram, redirect OAuth) ---------------------------------------
# URL publik dashboard TigerROI. Dipakai fungsi dashboardUrl() di dashboard-url.js.
DASHBOARD_URL=https://your-dashboard-domain.example.com
