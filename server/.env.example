# === Server Kontrol TigerROI (Backend Node.js / Bun + Elysia) ====================
# File konfigurasi backend. Salin ke `server/.env` saat menjalankan server.
# JANGAN PERNAH menyalin file ini ke frontend browser.

# --- Supabase (Postgres + Auth) ---------------------------------------------------
# Kunci service_role HANYA boleh ada di server/jobs backend, TIDAK BOLEH di frontend.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct / Pooling Connection String PostgreSQL Supabase
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# --- Server Jaringan & HTTP -------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# URL publik server ini (dipakai untuk authorized redirect URI saat consent Google OAuth)
# Lokal : http://localhost:8080
# VPS   : https://api.yourdomain.com (misal: https://api.tigerroi.com)
CONTROL_PUBLIC_URL=http://localhost:8080

# URL dashboard frontend (tujuan redirect setelah berhasil consent Google)
# Lokal : http://localhost:5173
# VPS   : https://dash.yourdomain.com (misal: https://dash.tigerroi.com)
DASHBOARD_URL=http://localhost:5173

# Daftar origin CORS yang diizinkan memanggil API kontrol (pisahkan dengan koma).
# JANGAN gunakan wildcard "*" karena API kontrol memeriksa kredensial auth.
ALLOWED_ORIGINS=http://localhost:5173,https://dash.yourdomain.com

# Jumlah reverse proxy tepercaya di depan server (1 jika di belakang CloudPanel/Nginx, 0 jika langsung)
TRUST_PROXY_HOPS=1

# --- Setup Sub & Otomasi CloudPanel (WordPress + SSL + Plugin) -------------------
# Path kunci SSH privat di server kontrol untuk remote eksekusi ke server CloudPanel
SETUP_SUB_SSH_KEY=/opt/tigerroi-control/ssh/tigerroi_setup_sub
SETUP_SUB_SSH_USER=tigerroi

# Kredensial root sementara (hanya dibutuhkan saat bootstrap server CloudPanel baru)
SETUP_SUB_ROOT_USER=root
SETUP_SUB_ROOT_PASSWORD=

# Akun admin default untuk instalasi WordPress baru
SETUP_SUB_WP_ADMIN_USER=tigeradmin
SETUP_SUB_WP_ADMIN_PASSWORD=

# Repositori GitHub resmi untuk unduhan rilis plugin TigerROI (ZIP)
# Format: organisasi/nama-repo
PLUGIN_REPO=your-org/tigerroi-plugin
# Personal Access Token (PAT) GitHub dengan hak baca (Contents: read-only) ke repo rilis plugin
PLUGIN_GITHUB_TOKEN=

# --- Manajemen Plugin TigerROI WordPress ------------------------------------------
# Enroll token master — ditanam di plugin WordPress. Dipakai hanya saat pertama kali enroll.
PLUGIN_ENROLL_TOKEN=

# Batas waktu panggilan ke WordPress (dalam milidetik) dan batas konkuren
PLUGIN_TIMEOUT_MS=20000
PLUGIN_CONCURRENCY=6

# --- Integrasi Cloudflare DNS (/domains & Setup Sub) -------------------------------
# API Token Cloudflare dengan izin: Zone:Read + DNS:Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TIMEOUT_MS=20000

# --- Integrasi Keitaro Tracker ----------------------------------------------------
# Alamat dasar dan API Key Keitaro (header Api-Key)
KEITARO_BASE_URL=https://tracker.yourdomain.com
KEITARO_API_KEY=
KEITARO_TEMPLATE_CAMPAIGN_ID=1

# --- Integrasi Meta Marketing API (Facebook / Instagram Ads) ---------------------
# System User Long-Lived Token dari Meta Business Manager (izin: ads_read, ads_management)
META_ACCESS_TOKEN=

# --- Integrasi Notifikasi Telegram ------------------------------------------------
# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=

# --- Jadwal Cron Tugas Internal Server --------------------------------------------
# Format cron @elysiajs/cron: 6 bidang (detik menit jam hari bulan hari_dalam_minggu)
SYNC_TIMEZONE=Asia/Jakarta
CAMPAIGN_CRON="30 */2 * * * *"
PLUGIN_CRON="0 0,30 * * * *"
TELEGRAM_CRON="15 * * * * *"
ACTIVITY_CRON="0 0 3 * * *"
ACTIVITY_LOG_DAYS=90
