# === TigerROI Dashboard (Frontend / Vite + React) =================================
# File konfigurasi frontend (browser). Salin ke `.env` saat menjalankan secara lokal.
# CATATAN KEAMANAN: Semua variabel berawalan VITE_* akan ikut terkompilasi ke dalam bundle
# JavaScript publik yang bisa dibaca siapa pun via devtools browser.
# JANGAN PERNAH meletakkan Supabase service_role key, password, atau token privat di sini!

# --- Supabase (Postgres + Auth) ---------------------------------------------------
# URL project Supabase Anda (misal: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase ANON / PUBLIC key (aman dipublikasikan ke frontend)
# Dapatkan dari: Supabase Console -> Project Settings -> API -> anon / public key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server Kontrol TigerROI (Backend Elysia / Node.js) ---------------------------
# Alamat server kontrol backend.
# Lokal : http://localhost:8080
# VPS   : https://api.yourdomain.com (misal: https://api.tigerroi.com)
VITE_CONTROL_API_URL=http://localhost:8080

# URL publik dashboard frontend ini (untuk redirect balik sesudah OAuth)
# Lokal : http://localhost:5173
# VPS   : https://dash.yourdomain.com
VITE_DASHBOARD_URL=http://localhost:5173

# --- Pengaturan Google OAuth Consent ----------------------------------------------
# URL callback otorisasi Google API (Ad Manager & AdSense)
VITE_OAUTH_CALLBACK_URL=http://localhost:8080/google/callback

# === Backend / Jobs / Cloudflare DNS (HANYA UNTUK SERVER/JOBS, JANGAN DIBERI VITE_*) ===
# Token API Cloudflare untuk sinkronisasi DNS subdomain otomatis.
# Dibuat dari: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Custom Token
# Izin Minimal (Least Privilege):
#   - Zone - Zone - Read (Membaca daftar zona & mencocokkan Zone ID)
#   - Zone - DNS - Edit  (Membaca, membuat, dan memperbarui DNS record subdomain)
# Zone Resources: Include -> All zones (atau spesifik 4 domain induk armada Anda)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ZONE_ID=optional-spesifik-zone-id

